class Solution(object):
    def countUnguarded(self, m, n, guards, walls):
        """
        :type m: int
        :type n: int
        :type guards: List[List[int]]
        :type walls: List[List[int]]
        :rtype: int
        """
        guards=set(map(tuple,guards))
        walls=set(map(tuple,walls))
        marked=set()
        for pos_x,pos_y in guards:
            for dx,dy in [(0,1),(0,-1),(1,0),(-1,0)]:
                x,y=pos_x+dx,pos_y+dy
                while 0<=x<m and 0<=y<n and (x,y) not in guards and (x,y) not in walls:
                    marked.add((x,y))
                    x+=dx
                    y+=dy
        return n*m-len(guards)-len(walls)-len(marked)
