class Solution(object):
    def findXSum(self, nums, k, x):
        """
        :type nums: List[int]
        :type k: int
        :type x: int
        :rtype: List[int]
        """
        from collections import OrderedDict
      
        def xsum(arr):
            d={}
            for i in arr:
                if i in d:
                    d[i]+=1
                else:
                    d[i]=1
            # print(d)        
            e =OrderedDict(sorted(d.items(), key=lambda x: (-x[1], -x[0]))) 
            # print(e) 
            val=0
            a=0
            for i in e:     
                if a>=x:
                    break
                a+=1    
                val+= i*e[i]
            return val    



        n=len(nums)
        ans=[]
        for i in range(n-k+1):
            # print(i,i+k)
            ans.append(xsum(nums[i:i+k]))
        return ans    
       
 






        
        
