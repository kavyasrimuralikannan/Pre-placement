class Helper():
    def __init__(self,capacity):
        self.capacity = capacity
        self.large = SortedList()
        self.small = SortedList()
        self.cnt = defaultdict(int)
        self.res = 0
    
    def insert(self,x):
        if self.cnt[x]>0:
            self._remove((self.cnt[x],x))
        self.cnt[x]+=1
        self._insert((self.cnt[x],x))

    def remove(self,x):
        self._remove((self.cnt[x],x))
        self.cnt[x]-=1
        if self.cnt[x]>0:
            self._insert((self.cnt[x],x))

    def _insert(self,pair):
        freq,val = pair
        if len(self.large)<self.capacity or pair>self.large[0]:
            self.res += freq*val
            self.large.add(pair)
            if len(self.large)>self.capacity:
                to_remove = self.large[0]
                self.res -= to_remove[0] * to_remove[1]
                self.large.remove(to_remove)
                self.small.add(to_remove)
        else:
            self.small.add(pair)

    def _remove(self,pair):
        freq,val = pair
        if pair>=self.large[0]:
            self.res -= freq*val
            self.large.remove(pair)
            if self.small:
                l = len(self.small)
                to_remove = self.small[l-1]
                self.small.remove(to_remove)
                self.large.add(to_remove)
                self.res += to_remove[0]*to_remove[1]
        else:
            self.small.remove(pair)

class Solution(object):
    def findXSum(self, nums, k, x):
        """
        :type nums: List[int]
        :type k: int
        :type x: int
        :rtype: List[int]
        """
        helper = Helper(x)
        ans = []
        n = len(nums)
        for i in range(n):
            helper.insert(nums[i])
            if i>=k:
                helper.remove(nums[i-k])
            if i>=k-1:
                ans.append(helper.res)
            
        return ans
