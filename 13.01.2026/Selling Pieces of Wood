import java.util.*;


public class Solution {

    // h-1 and w-1 places where we can cut
    // every cut splits the problem into 2 and we can recursively solve them !!!

    // also bottom up ofc to build from prev cases
    public long sellingWood(int maxH, int maxW, int[][] prices) {
        for (int[] e : prices) dp[e[0]][e[1]] = (long) e[2];

        for (int h = 1; h <= maxH; h++) {
            for (int w = 1; w <= maxW; w++) {
                for (int prevH = 1; prevH <= h / 2; prevH++) {
                    dp[h][w] = Math.max(dp[h][w], dp[prevH][w] + dp[h - prevH][w]);
                }
                for (int prevW = 1; prevW <= w / 2; prevW++) {
                    dp[h][w] = Math.max(dp[h][w], dp[h][prevW] + dp[h][w - prevW]);
                }
            }
        }
        return dp[maxH][maxW];


//        dp[0][0] = (long) p[0][0];
//        return recMemo(h, w);
    }

