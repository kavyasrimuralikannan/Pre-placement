class Spreadsheet {
    HashMap<Character,int[]> sheet;
    public Spreadsheet(int rows) {
        sheet = new HashMap<>();
        for(int i=0;i<26;i++){
            sheet.put( (char)('A'+i),new int[rows]);
        }
    }
    
    public void setCell(String cell, int value) {
        char ch1 = cell.charAt(0);
        String ch2 = cell.substring(1);
        int [] temp = sheet.get(ch1);
        temp[Integer.valueOf(ch2)-1] = value;
        sheet.put(ch1, temp);
    }
    
    public void resetCell(String cell) {
        char ch1 = cell.charAt(0);
        String ch2 = cell.substring(1);
        int [] temp = sheet.get(ch1);
        temp[Integer.valueOf(ch2)-1] = 0;
        sheet.put(ch1, temp);

    }
    
    public int getValue(String formula) {
        String[] val = formula.substring(1).split("\\+");
        String val1 = val[0];
        String val2 = val[1];
        int res1=0;
        int res2=0;
        if(!isInteger(val1)){
            char ch1 = val1.charAt(0);
            int ch2 = Integer.valueOf(val1.substring(1));
            int[] temp = sheet.get(ch1);
            res1 = temp[ch2-1];
        }
        else{
            res1 = Integer.valueOf(val1);
        }
        if(!isInteger(val2)){
            char ch21 = val2.charAt(0);
            int ch22 = Integer.valueOf(val2.substring(1));
            int[] temp2 = sheet.get(ch21);
            res2 = temp2[ch22-1];
        }
        else{
            res2 = Integer.valueOf(val2);
        }
        return res1+res2;
    }
    public static boolean isInteger(String str) {
        if (str == null || str.isEmpty()) return false;
        try {
            Integer.parseInt(str);
            return true;
        } catch (NumberFormatException e) {
            return false;
        }
    }
}

