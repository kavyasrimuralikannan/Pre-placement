class Solution 
{
    public boolean hasZero(int x) {
    while (x > 0) 
    {
        if (x % 10 == 0) return true;
        x /= 10;
    }
    return false;
}

public int[] getNoZeroIntegers(int n) {
    for (int i = 1; i < n; i++) {
        int j = n - i;
        if (!hasZero(i) && !hasZero(j)) {
            return new int[]{i, j};
        }
    }
    return new int[]{};
}

}
