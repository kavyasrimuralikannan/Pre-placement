class Solution {
    public int[] sumZero(int n) {
        int[] res = new int[n];
        int i=0;
        while(i<n){
            if(i==n-1){
                break;
            }
            res[i] = (i+1);
            res[i+1] = -(i+1);
            i+=2;
        }
        if(i==n-1){
            res[i] = 0;
        }
        return res;
    }
}
