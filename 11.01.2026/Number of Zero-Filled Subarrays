class Solution {
    public long zeroFilledSubarray(int[] nums) {
        long sol=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]==0){
                int count=0;
                while(i<nums.length&&nums[i++]==0)count++;
                sol+=((long)count*(count+1))/2;
                i--;
            }
        }
        return sol;
    }
}
