class Solution {
    public double maxAverageRatio(int[][] classes, int extraStudents) {
        PriorityQueue<double[]> max = new PriorityQueue<>((a, b) -> Double.compare(b[2], a[2]));
        int n = classes.length;
        for(int i=0;i<n;i++){
            max.offer(new double[]{classes[i][0], classes[i][1], gain(classes[i][0], classes[i][1])});
        }
        while(extraStudents-->0){
            double [] temp = max.poll();
            temp[0]+=1;
            temp[1]+=1;
            max.offer(new double[]{temp[0], temp[1], gain(temp[0], temp[1])});
        }
        double res = 0d;
        while(!max.isEmpty()){
            double [] temp = max.poll();
            res += (double) temp[0]/temp[1];
        }
        return res/n;
    }
    private double gain(double pass, double total) {
        return ((double) (pass + 1) / (total + 1)) - ((double) pass / total);
    }
}
