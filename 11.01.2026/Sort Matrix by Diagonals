class Solution {
    public int[][] sortMatrix(int[][] mat) 
    {
        int m=mat.length;
        int n=mat[0].length;
        Map<Integer,PriorityQueue<Integer>> dg=new HashMap<>();
        for(int row=0;row<m;row++)
        {
            for(int col=0;col<n;col++)
            {
                int key=row-col;
                dg.putIfAbsent(key, key < 0 
                                        ? new PriorityQueue<>()  //ascending order min heap
                                        :new PriorityQueue<>(Collections.reverseOrder())); //descending order max heap
                                        
                dg.get(key).add(mat[row][col]);                     
            }
        }

        for(int i=0;i<m;i++)
        {
            for(int j=0;j<n;j++)
            {
                int key=i-j;
                mat[i][j]=dg.get(key).poll();
            }
        }
        return mat;
    }
}
