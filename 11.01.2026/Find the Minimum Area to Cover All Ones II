class Solution {
    public int minimumSum(int[][] grid) {
        final int m = grid.length;
        final int n = grid[0].length;
        int ans = m * n;

        // Try splitting rows: top block vs bottom-left and bottom-right
        for (int i = 0; i < m; ++i) {
            final int top = minimumArea(grid, 0, i, 0, n - 1);
            for (int j = 0; j < n; ++j) {
                ans = Math.min(ans,
                    top
                    + minimumArea(grid, i + 1, m - 1, 0, j)      // bottom-left
                    + minimumArea(grid, i + 1, m - 1, j + 1, n - 1) // bottom-right
                );
            }
        }

        // Split rows: bottom block vs two top-left/right blocks
        for (int i = 0; i < m; ++i) {
            final int bottom = minimumArea(grid, i, m - 1, 0, n - 1);
            for (int j = 0; j < n; ++j) {
                ans = Math.min(ans,
                    bottom
                    + minimumArea(grid, 0, i - 1, 0, j)        // top-left
                    + minimumArea(grid, 0, i - 1, j + 1, n - 1)  // top-right
                );
            }
        }

        // Split columns: left block vs two right-top and right-bottom blocks
        for (int j = 0; j < n; ++j) {
            final int left = minimumArea(grid, 0, m - 1, 0, j);
            for (int i = 0; i < m; ++i) {
                ans = Math.min(ans,
                    left
                    + minimumArea(grid, 0, i, j + 1, n - 1)      // top-right
                    + minimumArea(grid, i + 1, m - 1, j + 1, n - 1) // bottom-right
                );
            }
        }

        // Another column-based split: right block vs top-left and bottom-left
        for (int j = 0; j < n; ++j) {
            final int right = minimumArea(grid, 0, m - 1, j, n - 1);
            for (int i = 0; i < m; ++i) {
                ans = Math.min(ans,
                    right
                    + minimumArea(grid, 0, i, 0, j - 1)         // top-left
                    + minimumArea(grid, i + 1, m - 1, 0, j - 1)    // bottom-left
                );
            }
        }

        // Horizontal cuts: three horizontal strips
        for (int i1 = 0; i1 < m; ++i1) {
            for (int i2 = i1 + 1; i2 < m; ++i2) {
                ans = Math.min(ans,
                    minimumArea(grid, 0, i1, 0, n - 1)   // top
                    + minimumArea(grid, i1 + 1, i2, 0, n - 1) // middle
                    + minimumArea(grid, i2 + 1, m - 1, 0, n - 1) // bottom
                );
            }
        }

        // Vertical cuts: three vertical strips
        for (int j1 = 0; j1 < n; ++j1) {
            for (int j2 = j1 + 1; j2 < n; ++j2) {
                ans = Math.min(ans,
                    minimumArea(grid, 0, m - 1, 0, j1)   // left
                    + minimumArea(grid, 0, m - 1, j1 + 1, j2) // middle
                    + minimumArea(grid, 0, m - 1, j2 + 1, n - 1) // right
                );
            }
        }

        return ans;
    }

    private int minimumArea(int[][] grid, int si, int ei, int sj, int ej) {
        int x1 = Integer.MAX_VALUE, y1 = Integer.MAX_VALUE;
        int x2 = -1, y2 = -1;
        for (int i = si; i <= ei; ++i) {
            for (int j = sj; j <= ej; ++j) {
                if (i < 0 || j < 0) continue; // handle out-of-bound slicing
                if (grid[i][j] == 1) {
                    x1 = Math.min(x1, i);
                    y1 = Math.min(y1, j);
                    x2 = Math.max(x2, i);
                    y2 = Math.max(y2, j);
                }
            }
        }
        if (x2 == -1) return 0; // no '1's in this subgrid
        return (x2 - x1 + 1) * (y2 - y1 + 1);
    }
}
