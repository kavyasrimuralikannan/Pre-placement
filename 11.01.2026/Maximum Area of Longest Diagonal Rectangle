class Solution {
    public int areaOfMaxDiagonal(int[][] dimensions) {
		double max = 0;
		int res = 0;
        for(int i=0;i<dimensions.length;i++){
            double temp = Math.sqrt((dimensions[i][0]*dimensions[i][0])+(dimensions[i][1]*dimensions[i][1]));
	        if(max<temp){
		        max = temp;
		        res = i;
	        }
	        else if(max==temp){
		        if(dimensions[res][0]*dimensions[res][1]<dimensions[i][0]*dimensions[i][1]){
			        res=i;
		        }
	        }
        }
        return dimensions[res][0]*dimensions[res][1];
    }
}
